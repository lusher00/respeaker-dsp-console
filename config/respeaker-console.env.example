# /etc/default/respeaker-console — environment for the respeaker-console service.
# Every value is optional; these are the defaults. Settings that are tuned at
# runtime (spacing, band, thresholds, PGA gain...) are NOT here: they are set
# from the page or POST /config and persist in /var/lib/respeaker-console.

# ALSA card name of the HAT (arecord -l). Used for amixer and the capture
# device. Card NUMBERS move with whatever enumerates first; the name does not.
RESPEAKER_CARD=seeed2micvoicec
RESPEAKER_DEVICE=hw:CARD=seeed2micvoicec,DEV=0

# Capture rate. Must be a multiple of 16000 (the classifier decimates to 16 kHz).
# 48000 gives the direction finder 2.9x the delay resolution of 16000.
RESPEAKER_RATE=48000

# HTTP port. 8080 is hailo-tracker and 8081 the lidar on the Pi 5; this one
# stays clear of both in case the HAT ever moves there.
RESPEAKER_HTTP_PORT=8082

# YAMNet model (./download_model.sh fetches it) and LiteRT threads. On a Zero
# 2 W, 2 threads leaves cores for capture and DSP.
#RESPEAKER_MODEL=/home/pi/respeaker-dsp-console/models/yamnet.tflite
RESPEAKER_THREADS=2
